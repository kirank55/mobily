{
  "name": "mobily",
  "version": "0.1.3",
  "description": "Mobile remote-control for terminal-based development environments.",
  "type": "module",
  "license": "MIT",
  "author": "Kiran",
  "homepage": "https://github.com/kirank55/mobily#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirank55/mobily.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/kirank55/mobily/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "android",
    "remote",
    "tmux",
    "pty",
    "devtunnels",
    "mobile"
  ],
  "bin": {
    "mobily": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@xterm/headless": "5.5.0",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "simple-git": "^3.36.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@mobily/shared": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.0.0"
  }
}
