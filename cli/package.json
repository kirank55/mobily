{
  "name": "mobily",
  "version": "0.0.0",
  "description": "Mobile remote-control for terminal-based development environments.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mobily": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsup",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mobily/shared": "workspace:*",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "simple-git": "^3.36.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.0.0"
  }
}
