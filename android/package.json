{
  "name": "mobily-android",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@mobily/shared": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.6",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/react": "~19.2.2",
    "@xterm/headless": "6.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "generate:terminal-assets": "node scripts/generate-terminal-assets.mjs",
    "prestart": "pnpm generate:terminal-assets",
    "preandroid": "pnpm generate:terminal-assets",
    "preios": "pnpm generate:terminal-assets",
    "preprebuild": "pnpm generate:terminal-assets",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prebuild": "expo prebuild --platform android",
    "build:android": "expo run:android",
    "eas-dev": "pnpm install --frozen-lockfile && pnpm exec expo prebuild --platform android --clean && pnpm exec eas build:dev --profile development --platform android",
    "eas-prod": "pnpm exec eas build --profile preview --platform android"
  }
}
